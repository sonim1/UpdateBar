# Copy this file to .env.release.local and fill in real values.
# Never commit .env.release.local.

# Repository-scope version App credentials (contents-write App installed only on sonim1/UpdateBar).
# Use literal escaped newlines (`\n`) for multiline PEMs in this file, or export
# the actual multiline value; raw multiline dotenv entries are rejected.
VERSION_GITHUB_APP_ID=
VERSION_GITHUB_APP_PRIVATE_KEY=

# Release environment credentials.
DEVELOPER_ID_APPLICATION=
SPARKLE_PUBLIC_ED_KEY=
CLOUDFLARE_ACCOUNT_ID=
TAP_GITHUB_APP_ID=

APPLE_CERTIFICATE_P12_BASE64=
APPLE_CERTIFICATE_PASSWORD=
APPLE_NOTARY_KEY_P8_BASE64=
APPLE_NOTARY_KEY_ID=
APPLE_NOTARY_ISSUER_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SPARKLE_PRIVATE_ED_KEY=
TAP_GITHUB_APP_PRIVATE_KEY=
